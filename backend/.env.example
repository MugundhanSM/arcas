# copy to .env and fill in

APP_NAME=ARCAS
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# PostgreSQL connection string
DATABASE_URL=postgresql://arcas_user:arcas_password@localhost:5432/arcas

# LLM endpoint that accepts {"prompt": ...} with a bearer token.
# Leave blank to run without an LLM (deterministic fallbacks).
LLM_API_URL=
LLM_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
